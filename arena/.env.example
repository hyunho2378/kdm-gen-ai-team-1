# Socket.io 중계 서버 주소. **하드코딩 폴백이 없다.** 비어 있으면 페어링을 시도하지 않고
# 곧장 키보드 경기로 간다(경기가 막히지는 않는다).
#   로컬  http://localhost:3001
#   배포  https://<render-service>.onrender.com
# **HTTPS 페이지에서는 https로만 적는다.** http를 적으면 브라우저가 혼합 콘텐츠로 막는다
# (socket.io가 이 주소에서 wss를 유도한다).
VITE_SERVER_URL=

# QR이 가리킬 controller 배포 URL. 페어링 화면 QR이 여기에 ?room=코드를 붙인다.
# 비어 있으면 QR 없이 방 코드만 크게 뜨고 폰에서 손으로 입력한다.
#   로컬  http://localhost:5174
#   배포  https://<controller>.vercel.app
VITE_CONTROLLER_URL=
