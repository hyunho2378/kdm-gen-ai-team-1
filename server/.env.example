PORT=3001

# 허용 오리진. 쉼표 구분, **끝 슬래시 없이 정확히.**
# 비어 있으면 로컬 두 포트(5173, 5174)가 기본값이다.
#   로컬  http://localhost:5173,http://localhost:5174
#   배포  https://<arena>.vercel.app,https://<controller>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 경기 기록 저장소. Postgres 접속 문자열(Neon, Render Postgres 등).
# **비어 있으면 기록 기능만 꺼지고 중계는 그대로 돈다.** 서버가 안 뜨지 않는다.
# 로컬 평문 접속이면 sslmode=disable을 붙인다. 호스팅 DB는 붙이지 않는다(TLS 기본).
#   로컬  postgres://user:pass@localhost:5432/vortex?sslmode=disable
#   Neon  postgres://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/vortex
DATABASE_URL=

# 쿠키 정책 스위치. production이면 SameSite=None + Secure로 내린다.
# 폰(Vercel)과 서버(Render)가 다른 도메인이면 이 값이 없으면 쿠키가 안 붙는다.
NODE_ENV=
